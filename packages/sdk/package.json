{
  "name": "@lume/agent-sdk",
  "version": "0.0.1",
  "description": "Open-source Agent SDK — runs the agent loop in-process. Source-level standalone build.",
  "type": "module",
  "main": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./embed": {
      "types": "./dist/embed.d.ts",
      "default": "./dist/embed.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./bridge": {
      "types": "./dist/bridge.d.ts",
      "default": "./dist/bridge.js"
    },
    "./sdk-tools": {
      "types": "./dist/sdk-tools.d.ts",
      "default": "./dist/sdk-tools.js"
    },
    "./sdk-tools.js": {
      "types": "./dist/sdk-tools.d.ts",
      "default": "./dist/sdk-tools.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "build:js": "tsup",
    "build:dts": "tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "node --test ./tests/reference-contract.test.mjs",
    "test:current-package-shape": "RUN_CURRENT_PACKAGE_SHAPE_TEST=1 node --test ./tests/current-package-shape.test.mjs",
    "refresh:reference-contract": "node ./scripts/extract-reference-contract.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/core": "^2.6.1",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-trace-base": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "ajv": "^8.17.0",
    "auto-bind": "^5.0.1",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "diff": "^7.0.0",
    "env-paths": "^3.0.0",
    "execa": "^9.5.0",
    "fuse.js": "^7.0.0",
    "https-proxy-agent": "^7.0.0",
    "ignore": "^7.0.0",
    "jsonc-parser": "^3.3.0",
    "lodash-es": "^4.17.21",
    "lru-cache": "^11.0.0",
    "marked": "^15.0.0",
    "p-map": "^7.0.0",
    "picomatch": "^4.0.0",
    "proper-lockfile": "^4.1.2",
    "semver": "^7.6.0",
    "shell-quote": "^1.8.0",
    "signal-exit": "^4.1.0",
    "stack-utils": "^2.0.0",
    "strip-ansi": "^7.1.0",
    "tree-kill": "^1.2.2",
    "type-fest": "^4.30.0",
    "undici": "^7.0.0",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-protocol": "^3.17.0",
    "ws": "^8.18.0",
    "xss": "^1.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.5.0",
    "@types/shell-quote": "^1.7.5",
    "@types/ws": "^8.5.0",
    "dotenv": "^17.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "agent-sdk",
    "claude",
    "anthropic",
    "ai",
    "llm",
    "tools",
    "agentic"
  ]
}
